# Application
APP_NAME=ClipForge AI
APP_VERSION=1.0.0
DEBUG=true
PORT=8000

# Security & CORS
SECRET_KEY=change-this-in-production-to-at-least-32-chars-long-secret-key
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage ("local" or "supabase")
STORAGE_BACKEND=local
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=500

# YouTube Data API v3 & OAuth 2.0
YOUTUBE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-your-google-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/callback
YOUTUBE_ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtZGV2LWtleS1mb3ItZmVybmV0ISE=

# AI Configuration
WHISPER_MODEL_SIZE=base
