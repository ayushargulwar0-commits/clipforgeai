# ===========================================================================
# AutoClip Internal Engine Service Configuration
# ===========================================================================

# Service Auth & Security
AUTOCLIP_INTERNAL_TOKEN=clipforge-internal-secret-2026
AUTOCLIP_HOST=0.0.0.0
PORT=8001

# Shared Volume Mount between AutoClip and ClipForge AI
SHARED_CLIPS_DIR=/data/clips

# LLM Provider Switch (gemini | openai | anthropic | dashscope)
LLM_PROVIDER=gemini
LLM_API_KEY=

# Specific Provider Keys (Optional overrides)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=

# Default Models (Auto-selects cheapest JSON model if blank)
# gemini: gemini-1.5-flash
# openai: gpt-4o-mini
# anthropic: claude-3-5-haiku-20241022
# dashscope: qwen-plus
API_MODEL_NAME=gemini-1.5-flash

# Speech Recognition / Whisper Configuration
WHISPER_MODEL=base

# Redis Queue (used in containerized docker-compose setup)
REDIS_URL=redis://redis:6379/0
DATABASE_URL=sqlite:///./data/autoclip.db
